# pub uses this file INSTEAD of .gitignore for this directory, so it repeats
# the .gitignore patterns that matter for the archive. pub always skips hidden
# files and directories (.dart_tool/, .github/, .idea/).

# Local artifacts and debug output (repeated from .gitignore).
/pubspec.lock
*.log
*.class
*.pyc
*.swp
*.iml
*.ipr
*.iws
**/doc/api/
build/
coverage/
migrate_working_dir/

# Maintainer-only tooling, benchmarks, and contributor docs.
tool/
tooling/
benchmark/
AGENTS.md
CLAUDE.md
docs_guide.md
firebase-debug.log
